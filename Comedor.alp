					<Name><![CDATA[setAnimation]]></Name>
					<X>50</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[animationIndex]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < animations.size(); i++) {
	Shape shape = (Shape)animations.get(i);
	if (i == animationIndex)
		shape.setVisible(true);
	else
		shape.setVisible(false);
}
oval.setFillColor(colors.get(animationIndex));]]></Body>
				</Function>
